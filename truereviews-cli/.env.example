# TrueReviews Kişisel Rapor — örnek ortam değişkenleri
# Bu dosyayı `.env` olarak kopyalayın ve kullandığınız sağlayıcıların anahtarlarını doldurun.
# `providers.yaml` içindeki `api_key_env` alanı bu değişken adlarını referans alır.
# Yalnızca kullandığınız sağlayıcının anahtarı gerekir; diğerleri boş kalabilir.

# Google Gemini (varsayılan sağlayıcı: gemini-3.8-flash)
GEMINI_API_KEY=

# Z.ai GLM (openai_compat adaptörü, base_url: https://open.bigmodel.cn/api/paas/v4)
GLM_API_KEY=

# DeepSeek (openai_compat adaptörü, base_url: https://api.deepseek.com)
DEEPSEEK_API_KEY=

# OpenRouter (openai_compat adaptörü, base_url: https://openrouter.ai/api/v1)
OPENROUTER_API_KEY=
