# — Supabase (https://supabase.com/dashboard → yeni proje → Settings → API) —
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# — Apify (https://console.apify.com/account/integrations) —
APIFY_API_TOKEN=
# Actor: compass/google-maps-reviews-scraper
APIFY_ACTOR_ID=compass/google-maps-reviews-scraper

# — Google AI Studio / Gemini (Gemma 4 31B) (https://aistudio.google.com/app/apikey) —
GOOGLE_AI_API_KEY=
GEMMA_MODEL=gemma-3-27b-it
# Not: planda "Gemma 4 31B" yazıyor. AI Studio'da o isimde model yoksa
# GEMMA_MODEL adını konsoldaki gerçek model id ile değiştirin (örn. gemma-3-27b-it).

# — Resend (double opt-in e-postaları) (https://resend.com/api-keys) —
RESEND_API_KEY=
RESEND_FROM=Yorum Analizi <rapor@ornek.com>
# RESEND yoksa sistem otomatik MOCK e-posta moduna düşer:
# onay linki terminal (Vercel log) + ekrandaki "geliştirici önizlemesi" kutusunda gösterilir.

# — Cloudflare Turnstile (https://dash.cloudflare.com → Turnstile) —
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Anahtarlar yoksa Turnstile doğrulaması otomatik "pasif" moda düşer (form çalışır).

# — Uygulama —
NEXT_PUBLIC_APP_URL=http://localhost:3000
DAILY_NEW_ANALYSIS_LIMIT=12
RATE_LIMIT_PER_HOUR=2
CACHE_TTL_HOURS=24
MAX_REVIEWS=20
