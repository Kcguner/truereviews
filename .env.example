# — Upstash Redis (kota + rapor önbelleği + token; Supabase yerine) —
# https://console.upstash.com → Create Database → REST API sekmesi
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Redis yoksa sistem memory fallback ile çalışır (dev için OK,
# prod için Redis şart — yoksa limitler delinebilir, raporlar uçar).

# — Apify (https://console.apify.com/account/integrations) —
APIFY_API_TOKEN=
# Actor: compass/google-maps-reviews-scraper
APIFY_ACTOR_ID=compass/google-maps-reviews-scraper

# — Google AI Studio / Gemini (https://aistudio.google.com/app/apikey) —
GOOGLE_AI_API_KEY=
GEMMA_MODEL=gemma-4-31b-it
# GEMMA_MODEL: AI Studio konsolundaki gerçek model id yazılmalı (Gemini API id'si).
# Yanlış id → API 404 → rapor üretilemez. Şüphede konsolu kontrol edin.

# — Brevo (double opt-in e-postaları; domainsiz sender ile) —
# 1) brevo.com → ücretsiz hesap (telefon yok, e-posta doğrulamalı)
# 2) Senders bölümünde Gmail adresini doğrula (gelen kutuna kod gelir)
# 3) SMTP & API sayfasından API key üret
BREVO_API_KEY=
BREVO_FROM=
# ÖRN: BREVO_FROM=TrueReviews <senin-adresin@gmail.com>  (doğruladığın adresle birebir aynı olmalı)
# BREVO_FROM boş ya da geçersizse API açıkça hata verir (sessiz gönderim yok).
# KEY yoksa sistem otomatik MOCK e-posta moduna düşer:
# onay linki terminal (Vercel log) + ekrandaki "geliştirici önizlemesi" kutusunda gösterilir.
# Ücretsiz kota: günde 300 e-posta.

# — Admin / test kolaylığı (double opt-in'siz anında rapor) —
# Yetkilendirme YALNIZCA aşağıdaki ADMIN_BYPASS_TOKEN ile yapılır.
# /api/lead artık gelen e-posta adresine bakmaz: gövdede/başlıkta anahtar yoksa
# onay e-postası gönderilir (dönen `adminBypass` yalnızca anahtarı bilenler içindir).
# ÖNEMLİ: ADMIN_EMAILS artık HİÇBİR yetkilendirme işlevi görmez (eski, güvensiz
# e-posta listesi kaldırıldı). Değer yalnızca lib/admin.ts'teki yardımcıları ve
# testleri besler; uygulamada kullanılmıyor, boş bırakılabilir.
# ÖRN: ADMIN_EMAILS=
ADMIN_EMAILS=
# — Kota/limit muafiyeti + doğrulama e-postasını atlama için gizli sunucu anahtarı —
# Rastgele uzun bir değer üret (örn. PowerShell: [Guid]::NewGuid().ToString('N') + [Guid]::NewGuid().ToString('N'))
# İstemci, anahtarı istek gövdesinde `adminKey` (ya da `x-admin-key` başlığında) gönderir.
# Bilen istekler /api/analyze'ta rate-limit + günlük kotaya takılmaz, /api/lead'de
# doğrulama e-postası beklemeden tam raporu alır.
# KİMSEYLE PAYLAŞMAYIN (ben dahil); bilen tarayıcısındaki "Test anahtarı" alanına yazar.
# Boşsa hiçbir istek muafiyet/rapor erişimi kazanamaz.
ADMIN_BYPASS_TOKEN=

# — Cloudflare Turnstile (https://dash.cloudflare.com → Turnstile) —
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Anahtarlar yoksa Turnstile doğrulaması otomatik "pasif" moda düşer (form çalışır).

# — Uygulama —
# ÜRETİMDE ZORUNLU. Doğrulama (double opt-in) linkinin tek kaynağı budur:
# bozuk/eksikse istek başlığına (Origin/Host) ASLA düşülmez, üretimde hata verilir
# (fail-closed) — aksi halde onay linki saldırganın domainine yönlenebilirdi.
# Düz, mutlak bir http(s) adres olmalı (query/fragment/kimlik bilgisi yok; üretimde https).
APP_URL=http://localhost:3000
# Private env (NEXT_PUBLIC_ yok — tarayıcıya sızmaz).
# Üretimde gerçek domain yazılmalı (örn. https://get-truereviews.vercel.app).
# SEO/GEO: sitemap, canonical, OG ve JSON-LD bu adresi kullanır.
# — Google Search Console doğrulama (https://search.google.com/search-console) —
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# — Gizlilik-dostu analitik (opsiyonel, Plausible) —
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Self-host Plausible kullanıyorsanız:
# NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.ornek.com/js/script.js
# — İletişim sayfasında görünen e-posta (opsiyonel) —
NEXT_PUBLIC_CONTACT_EMAIL=
DAILY_NEW_ANALYSIS_LIMIT=12
RATE_LIMIT_PER_HOUR=2
CACHE_TTL_HOURS=24
MAX_REVIEWS=20
